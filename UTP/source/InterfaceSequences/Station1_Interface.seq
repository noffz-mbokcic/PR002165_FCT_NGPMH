%NAME = "Device from Station4 is ready for UNLOADING"

[SF.Seq[1].Main[26].TS]
Id = "ID#:p0KKCUTf8BGJ2MyCf5xeVC"
PostExpr Line0001 = "Locals.DevicePassed = (FileGlobals.DUT.Station1 && FileGlobals.DUT.Station2 && FileGlobals.DUT.Station3 && FileGlobals.D"
PostExpr Line0002 = "UT.Station4)\n//,FileGlobals.DUT_PASSED_Previous_Stations = Locals.DevicePassed"

[DEF, SF.Seq[1].Main[26]]
%NAME = "Check if device passed testing on All stations"

[SF.Seq[1].Main[27].TS]
Id = "ID#:eEMPPEXf8BGJ2MyCf5xeVC"

[SF.Seq[1].Main[27]]
ConditionExpr Line0001 = "StationGlobals.MES.Active && Locals.DevicePassed // MES has to be active and device needs to pass testing before sending"
ConditionExpr Line0002 = " MES command"
%COMMENT = "Check if MES is active"

[DEF, SF.Seq[1].Main[27]]
%NAME = "If"

[SF.Seq[1].Main[28].TS]
Id = "ID#:efYXTETf8BGJ2MyCf5xeVC"
%HI: AdditionalResultsHints = [2]


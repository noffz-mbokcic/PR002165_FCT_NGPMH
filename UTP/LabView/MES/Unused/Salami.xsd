<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://tempuri.org/" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Mode" type="xs:string"/>
  <xs:element name="Operator" type="xs:string"/>
  <xs:element name="SerialNo" type="xs:string"/>
  <xs:element name="HuNo" type="xs:string"/>
  <xs:element name="MaterialCode" type="xs:string"/>
  <xs:element name="PackingInstructions" type="xs:string"/>
  <xs:element name="ProductionVersion" type="xs:string"/>
  <xs:element name="requestParameters">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tem:Mode" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:Operator" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:SerialNo" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:HuNo" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:MaterialCode" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:PackingInstructions" xmlns:tem="http://tempuri.org/"/>
        <xs:element ref="tem:ProductionVersion" xmlns:tem="http://tempuri.org/"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Execute">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tem:requestParameters" xmlns:tem="http://tempuri.org/"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>